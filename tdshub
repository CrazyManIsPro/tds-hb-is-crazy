-- Inventory Item Swapper Tab
local TabInventory = Window:MakeTab({
    Name = "Inventory Item Swapper",
    Icon = "rbxassetid://4483345998",
    PremiumOnly = false
})

local Players = game:GetService("Players")
local player = Players.LocalPlayer

local function switchInventory()
    local backpack = player:FindFirstChild("Backpack")
    if not backpack then return end

    local tools = {}

    for _, item in ipairs(backpack:GetChildren()) do
        if item:IsA("Tool") then
            table.insert(tools, item)
        end
    end

    -- Needs at least: Punch, Phone, Gun, Gun
    if #tools < 4 then
        warn("[InventorySwapper] Not enough tools.")
        return
    end

    -- 3→1, 4→2, 1→3, 2→4
    local reordered = {
        tools[3],
        tools[4],
        tools[1],
        tools[2]
    }

    for i = 5, #tools do
        reordered[#reordered + 1] = tools[i]
    end

    -- Reinsert order
    for _, tool in ipairs(tools) do
        tool.Parent = nil
    end

    task.wait()

    for _, tool in ipairs(reordered) do
        tool.Parent = backpack
    end
end

TabInventory:AddButton({
    Name = "Switch Inventory (3↔1, 4↔2)",
    Callback = switchInventory
})

